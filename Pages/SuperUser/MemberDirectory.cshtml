@page
@model MosqueRegistrationApp.Pages.SuperUser.MemberDirectoryModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{ 
    ViewData["Title"] = Localizer["PageTitle"]; 
}

<!-- Header -->
<div class="row align-items-center mb-3 mb-md-4 g-2">
    <div class="col-12">
        <h2 class="fw-bold mb-1 fs-4 fs-md-2" style="color: var(--primary-emerald);">
            <i class="bi bi-people-fill text-gold me-2"></i>@Localizer["PortalTitle"]
        </h2>
        <p class="text-muted mb-0 small fs-6">@Localizer["PortalDescription"]</p>
    </div>
</div>

<!-- Super User's Personal Profile Summary Card -->
@if (Model.CurrentUserProfile != null)
{
    <div class="card card-custom border-0 shadow-sm mb-4 bg-light">
        <div class="card-header bg-white border-bottom py-2.5 px-3 d-flex justify-content-between align-items-center">
            <span class="fw-bold text-dark fs-6">
                <i class="bi bi-person-badge text-gold me-2"></i> @Localizer["ProfileCardHeader"]
            </span>
            <span class="badge bg-info text-dark">@Localizer["SuperUserAccountBadge"]</span>
        </div>
        <div class="card-body p-3 p-sm-4">
            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <small class="text-muted d-block">@Localizer["ColumnFullName"]</small>
                    <span class="fw-semibold text-dark">@Model.CurrentUserProfile.FullName</span>
                </div>
                <div class="col-12 col-md-4">
                    <small class="text-muted d-block">@Localizer["ColumnIcNumber"]</small>
                    <code>@Model.CurrentUserProfile.IcNumber</code>
                </div>
                <div class="col-12 col-md-4">
                    <small class="text-muted d-block">@Localizer["ColumnPhoneNumber"]</small>
                    <span>@(string.IsNullOrEmpty(Model.CurrentUserProfile.PhoneNumber) ? "N/A" : Model.CurrentUserProfile.PhoneNumber)</span>
                </div>
                <div class="col-12 col-md-4">
                    <small class="text-muted d-block">@Localizer["ColumnAddress"]</small>
                    <span>@Model.CurrentUserProfile.CurrentAddress</span>
                </div>
                <div class="col-12 col-md-4">
                    <small class="text-muted d-block">@Localizer["ColumnMaritalStatus"]</small>
                    <span>@Model.CurrentUserProfile.MaritalStatus</span>
                </div>
                <div class="col-12 col-md-4">
                    <small class="text-muted d-block">@Localizer["ColumnResidencyDuration"]</small>
                    <span>@Model.CurrentUserProfile.ResidencyDurationYears @Localizer["YearsLabel"]</span>
                </div>
            </div>
        </div>
    </div>
}

<!-- Search & Filter Card -->
<div class="card card-custom p-3 mb-3 mb-md-4 shadow-sm border-0">
    <form method="get" class="row g-2 g-md-3">
        <div class="col-12 col-md-6">
            <div class="input-group input-group-lg-mobile">
                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" 
                       asp-for="SearchTerm" 
                       class="form-control border-start-0 fs-6" 
                       placeholder="@Localizer["SearchPlaceholder"]" />
            </div>
        </div>
        <div class="col-12 col-md-3">
            <select asp-for="StatusFilter" class="form-select fs-6">
                <option value="All">@Localizer["FilterAllStatuses"]</option>
                <option value="Pending">@Localizer["FilterPending"]</option>
                <option value="Approved">@Localizer["FilterApproved"]</option>
                <option value="Rejected">@Localizer["FilterRejected"]</option>
            </select>
        </div>
        <div class="col-12 col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-emerald flex-grow-1 py-2 fs-6">@Localizer["FilterButton"]</button>
            <a asp-page="/SuperUser/MemberDirectory" class="btn btn-outline-secondary flex-grow-1 flex-md-grow-0 py-2 fs-6">@Localizer["ResetButton"]</a>
        </div>
    </form>
</div>

<!-- Member Directory Container -->
<div class="card card-custom overflow-hidden shadow-sm border-0 mb-4">
    <div class="card-header card-header-emerald d-flex justify-content-between align-items-center py-3 px-3">
        <h5 class="mb-0 fw-semibold fs-6 fs-md-5"><i class="bi bi-people me-2"></i>@Localizer["TableHeaderTitle"]</h5>
        <span class="badge bg-white text-dark fw-bold px-2 py-1 fs-7">@Localizer["TotalLabel"]: @(Model.RegisteredUsers?.Count ?? 0)</span>
    </div>
    
    <div class="card-body p-0">
        @if (Model.RegisteredUsers != null && Model.RegisteredUsers.Count > 0)
        {
            <!-- 1. DESKTOP VIEW: Data Table -->
            <div class="table-responsive d-none d-md-block">
                <table class="table table-custom align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-3 text-nowrap">@Localizer["ColumnFullName"]</th>
                            <th class="text-nowrap">@Localizer["ColumnIcNumber"]</th>
                            <th class="text-nowrap">@Localizer["ColumnPhoneNumber"]</th>
                            <th class="text-nowrap">@Localizer["ColumnAddress"]</th>
                            <th class="text-nowrap">@Localizer["ColumnMaritalStatus"]</th>
                            <th class="text-nowrap">@Localizer["ColumnResidencyDuration"]</th>
                            <th class="text-end pe-3 text-nowrap">@Localizer["ColumnStatus"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.RegisteredUsers)
                        {
                            <tr>
                                <td class="ps-3 fw-medium text-nowrap">@user.FullName</td>
                                <td class="text-nowrap"><code>@user.IcNumber</code></td>
                                <td class="text-nowrap">
                                    @if (!string.IsNullOrEmpty(user.PhoneNumber))
                                    {
                                        <a href="tel:@user.PhoneNumber" class="text-decoration-none">
                                            <i class="bi bi-telephone me-1 text-muted"></i>@user.PhoneNumber
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">N/A</span>
                                    }
                                </td>
                                <td><small class="text-muted">@user.CurrentAddress</small></td>
                                <td class="text-nowrap">@user.MaritalStatus</td>
                                <td class="text-nowrap">@user.ResidencyDurationYears @Localizer["YearsAbbr"]</td>
                                <td class="text-end pe-3 text-nowrap">
                                    @if (user.ApprovalStatus == "Approved")
                                    {
                                        <span class="badge-approved text-nowrap d-inline-flex align-items-center"><i class="bi bi-check-circle me-1"></i> @Localizer["StatusApproved"]</span>
                                    }
                                    else if (user.ApprovalStatus == "Rejected")
                                    {
                                        <span class="badge-rejected text-nowrap d-inline-flex align-items-center"><i class="bi bi-x-circle me-1"></i> @Localizer["StatusRejected"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge-pending text-nowrap d-inline-flex align-items-center"><i class="bi bi-hourglass-split me-1"></i> @Localizer["StatusPending"]</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- 2. MOBILE VIEW: Stacked Cards List -->
            <div class="d-md-none p-2">
                @foreach (var user in Model.RegisteredUsers)
                {
                    <div class="card mb-2 border shadow-sm rounded-3">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h6 class="fw-bold mb-0 text-dark">@user.FullName</h6>
                                    <small class="text-muted"><code class="fs-7">@user.IcNumber</code></small>
                                </div>
                                <div>
                                    @if (user.ApprovalStatus == "Approved")
                                    {
                                        <span class="badge-approved small text-nowrap d-inline-flex align-items-center"><i class="bi bi-check-circle me-1"></i> @Localizer["StatusApproved"]</span>
                                    }
                                    else if (user.ApprovalStatus == "Rejected")
                                    {
                                        <span class="badge-rejected small text-nowrap d-inline-flex align-items-center"><i class="bi bi-x-circle me-1"></i> @Localizer["StatusRejected"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge-pending small text-nowrap d-inline-flex align-items-center"><i class="bi bi-hourglass-split me-1"></i> @Localizer["StatusPending"]</span>
                                    }
                                </div>
                            </div>

                            <p class="small text-muted mb-1">
                                <i class="bi bi-telephone me-1"></i>
                                @if (!string.IsNullOrEmpty(user.PhoneNumber))
                                {
                                    <a href="tel:@user.PhoneNumber" class="text-decoration-none">@user.PhoneNumber</a>
                                }
                                else
                                {
                                    <span>N/A</span>
                                }
                            </p>
                            <p class="small text-muted mb-1"><i class="bi bi-geo-alt me-1"></i>@user.CurrentAddress</p>
                            <p class="small text-muted mb-0">
                                <i class="bi bi-heart me-1"></i>@user.MaritalStatus | <i class="bi bi-calendar-check me-1"></i>@user.ResidencyDurationYears @Localizer["YearsResidencyLabel"]
                            </p>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-4 px-3 text-muted">
                <i class="bi bi-inbox display-6 d-block mb-2"></i>
                <p class="mb-0 fs-6">@Localizer["NoRecordsFound"]</p>
            </div>
        }
    </div>
</div>