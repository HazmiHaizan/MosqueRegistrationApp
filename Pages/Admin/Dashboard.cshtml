@page
@model MosqueRegistrationApp.Pages.Admin.DashboardModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{ 
    ViewData["Title"] = Localizer["PageTitle"]; 
}

<!-- Header & Export Action -->
<div class="row align-items-center mb-3 mb-md-4 g-2">
    <div class="col-12 col-md-8">
        <h2 class="fw-bold mb-1 fs-4 fs-md-2" style="color: var(--primary-emerald);">
            <i class="bi bi-shield-check text-gold me-2"></i>@Localizer["PortalTitle"]
        </h2>
        <p class="text-muted mb-0 small fs-6">@Localizer["PortalDescription"]</p>
    </div>
    <div class="col-12 col-md-4 text-md-end mt-2 mt-md-0">
        <form method="post" asp-page-handler="ExportCsv">
            <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
            <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
            <button type="submit" class="btn btn-gold shadow-sm w-100 w-md-auto py-2">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i> @Localizer["ExportCsvButton"]
            </button>
        </form>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="card card-custom p-3 mb-3 mb-md-4 shadow-sm border-0">
    <form method="get" class="row g-2 g-md-3">
        <div class="col-12 col-md-6">
            <div class="input-group input-group-lg-mobile">
                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" 
                       asp-for="SearchTerm" 
                       class="form-control border-start-0 fs-6" 
                       placeholder="@Localizer["SearchPlaceholder"]" />
            </div>
        </div>
        <div class="col-12 col-md-3">
            <select asp-for="StatusFilter" class="form-select fs-6">
                <option value="All">@Localizer["FilterAllStatuses"]</option>
                <option value="Pending">@Localizer["FilterPending"]</option>
                <option value="Approved">@Localizer["FilterApproved"]</option>
                <option value="Rejected">@Localizer["FilterRejected"]</option>
            </select>
        </div>
        <div class="col-12 col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-emerald flex-grow-1 py-2 fs-6">@Localizer["FilterButton"]</button>
            <a asp-page="/Admin/Dashboard" class="btn btn-outline-secondary flex-grow-1 flex-md-grow-0 py-2 fs-6">@Localizer["ResetButton"]</a>
        </div>
    </form>
</div>

<!-- Member Directory Container -->
<div class="card card-custom overflow-hidden shadow-sm border-0 mb-4">
    <div class="card-header card-header-emerald d-flex justify-content-between align-items-center py-3 px-3">
        <h5 class="mb-0 fw-semibold fs-6 fs-md-5"><i class="bi bi-people me-2"></i>@Localizer["TableHeaderTitle"]</h5>
        <span class="badge bg-white text-dark fw-bold px-2 py-1 fs-7">@Localizer["TotalLabel"]: @(Model.RegisteredUsers?.Count ?? 0)</span>
    </div>
    
    <div class="card-body p-0">
        @if (Model.RegisteredUsers != null && Model.RegisteredUsers.Count > 0)
        {
            <!-- 1. DESKTOP VIEW: Data Table (visible on medium screens and up) -->
            <div class="table-responsive d-none d-md-block">
                <table class="table table-custom align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-3 text-nowrap">@Localizer["ColumnFullName"]</th>
                            <th class="text-nowrap">@Localizer["ColumnIcNumber"]</th>
                            <th class="text-nowrap">@Localizer["ColumnPhoneNumber"]</th>
                            <th class="text-nowrap">@Localizer["ColumnAddress"]</th>
                            <th class="text-nowrap">Role / Tier</th>
                            <th class="text-nowrap">@Localizer["ColumnProofDocument"]</th>
                            <th class="text-nowrap">@Localizer["ColumnStatus"]</th>
                            <th class="text-end pe-3 text-nowrap">@Localizer["ColumnActions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.RegisteredUsers)
                        {
                            <tr>
                                <td class="ps-3 fw-medium text-nowrap">@item.User.FullName</td>
                                <td class="text-nowrap"><code>@item.User.IcNumber</code></td>
                                <td class="text-nowrap">
                                    @if (!string.IsNullOrEmpty(item.User.PhoneNumber))
                                    {
                                        <a href="tel:@item.User.PhoneNumber" class="text-decoration-none">
                                            <i class="bi bi-telephone me-1 text-muted"></i>@item.User.PhoneNumber
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">N/A</span>
                                    }
                                </td>
                                <td><small class="text-muted">@item.User.CurrentAddress</small></td>
                                <td class="text-nowrap">
                                    @if (item.IsAdmin)
                                    {
                                        <span class="badge bg-danger text-white">Admin</span>
                                    }
                                    else if (item.IsSuperUser)
                                    {
                                        <span class="badge bg-info text-dark">Super User</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">User</span>
                                    }
                                </td>
                                <td class="text-nowrap">
                                    @if (!string.IsNullOrEmpty(item.User.ProofOfResidencyImagePath))
                                    {
                                        <a href="@item.User.ProofOfResidencyImagePath" target="_blank" class="btn btn-sm btn-outline-success rounded-pill">
                                            <i class="bi bi-file-image me-1"></i> @Localizer["ViewProofButton"]
                                        </a>
                                    }
                                </td>
                                <td class="text-nowrap">
                                    @if (item.User.ApprovalStatus == "Approved")
                                    {
                                        <span class="badge-approved text-nowrap d-inline-flex align-items-center"><i class="bi bi-check-circle me-1"></i> @Localizer["StatusApproved"]</span>
                                    }
                                    else if (item.User.ApprovalStatus == "Rejected")
                                    {
                                        <span class="badge-rejected text-nowrap d-inline-flex align-items-center"><i class="bi bi-x-circle me-1"></i> @Localizer["StatusRejected"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge-pending text-nowrap d-inline-flex align-items-center"><i class="bi bi-hourglass-split me-1"></i> @Localizer["StatusPending"]</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    @if (!item.IsAdmin)
                                    {
                                        <div class="d-inline-flex align-items-center justify-content-end gap-1 flex-nowrap">
                                            <!-- Toggle Super User Button -->
                                            <form method="post" asp-page-handler="ToggleSuperUser" class="d-inline">
                                                <input type="hidden" name="userId" value="@item.User.Id" />
                                                <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                                                <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
                                                @if (item.IsSuperUser)
                                                {
                                                    <button type="submit" class="btn btn-sm btn-outline-warning rounded-circle p-1 d-inline-flex align-items-center justify-content-center" style="width: 31px; height: 31px;" onclick="return confirm('Demote this user to standard user?');" title="Demote to User">
                                                        <i class="bi bi-arrow-down-circle fs-6"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit" class="btn btn-sm btn-outline-info rounded-circle p-1 d-inline-flex align-items-center justify-content-center" style="width: 31px; height: 31px;" onclick="return confirm('Upgrade this user to Super User?');" title="Promote to Super User">
                                                        <i class="bi bi-arrow-up-circle fs-6"></i>
                                                    </button>
                                                }
                                            </form>

                                            <!-- Approve Button -->
                                            <form method="post" asp-page-handler="UpdateStatus" class="d-inline">
                                                <input type="hidden" name="userId" value="@item.User.Id" />
                                                <input type="hidden" name="status" value="Approved" />
                                                <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                                                <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
                                                <button type="submit" class="btn btn-sm btn-success rounded-pill px-2.5">@Localizer["ActionApprove"]</button>
                                            </form>

                                            <!-- Reject Button -->
                                            <form method="post" asp-page-handler="UpdateStatus" class="d-inline">
                                                <input type="hidden" name="userId" value="@item.User.Id" />
                                                <input type="hidden" name="status" value="Rejected" />
                                                <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                                                <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2.5">@Localizer["ActionReject"]</button>
                                            </form>

                                            <!-- Edit Button -->
                                            <a asp-page="/Admin/EditUser" asp-route-id="@item.User.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-2.5">
                                                <i class="bi bi-pencil me-1"></i>@Localizer["ActionEdit"]
                                            </a>

                                            <!-- Delete Button -->
                                            <a asp-page="/Admin/DeleteUser" asp-route-id="@item.User.Id" class="btn btn-sm btn-danger rounded-pill px-2.5">
                                                <i class="bi bi-trash me-1"></i>@Localizer["ActionDelete"]
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic text-nowrap">Protected Account</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- 2. MOBILE VIEW: Stacked Cards List (visible on mobile screens) -->
            <div class="d-md-none p-2">
                @foreach (var item in Model.RegisteredUsers)
                {
                    <div class="card mb-2 border shadow-sm rounded-3">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h6 class="fw-bold mb-0 text-dark">@item.User.FullName</h6>
                                    <small class="text-muted"><code class="fs-7">@item.User.IcNumber</code></small>
                                </div>
                                <div class="text-end">
                                    @if (item.IsAdmin)
                                    {
                                        <span class="badge bg-danger text-white small mb-1 d-block">Admin</span>
                                    }
                                    else if (item.IsSuperUser)
                                    {
                                        <span class="badge bg-info text-dark small mb-1 d-block">Super User</span>
                                    }

                                    @if (item.User.ApprovalStatus == "Approved")
                                    {
                                        <span class="badge-approved small text-nowrap"><i class="bi bi-check-circle me-1"></i> @Localizer["StatusApproved"]</span>
                                    }
                                    else if (item.User.ApprovalStatus == "Rejected")
                                    {
                                        <span class="badge-rejected small text-nowrap"><i class="bi bi-x-circle me-1"></i> @Localizer["StatusRejected"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge-pending small text-nowrap"><i class="bi bi-hourglass-split me-1"></i> @Localizer["StatusPending"]</span>
                                    }
                                </div>
                            </div>

                            <p class="small text-muted mb-1">
                                <i class="bi bi-telephone me-1"></i>
                                @if (!string.IsNullOrEmpty(item.User.PhoneNumber))
                                {
                                    <a href="tel:@item.User.PhoneNumber" class="text-decoration-none">@item.User.PhoneNumber</a>
                                }
                                else
                                {
                                    <span>N/A</span>
                                }
                            </p>
                            <p class="small text-muted mb-2"><i class="bi bi-geo-alt me-1"></i>@item.User.CurrentAddress</p>

                            @if (!string.IsNullOrEmpty(item.User.ProofOfResidencyImagePath))
                            {
                                <div class="mb-3">
                                    <a href="@item.User.ProofOfResidencyImagePath" target="_blank" class="btn btn-sm btn-outline-success rounded-pill w-100 py-1">
                                        <i class="bi bi-file-image me-1"></i> @Localizer["ViewProofButton"]
                                    </a>
                                </div>
                            }

                            <div class="d-flex flex-wrap gap-2 pt-2 border-top">
                                @if (!item.IsAdmin)
                                {
                                    <!-- Mobile Toggle Super User -->
                                    <form method="post" asp-page-handler="ToggleSuperUser" class="w-100">
                                        <input type="hidden" name="userId" value="@item.User.Id" />
                                        <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                                        <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
                                        @if (item.IsSuperUser)
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-warning rounded-pill w-100 py-1.5 fw-semibold" onclick="return confirm('Demote this user to standard user?');">
                                                <i class="bi bi-arrow-down-circle me-1"></i> Demote to Standard User
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-info rounded-pill w-100 py-1.5 fw-semibold" onclick="return confirm('Upgrade this user to Super User?');">
                                                <i class="bi bi-arrow-up-circle me-1"></i> Make Super User
                                            </button>
                                        }
                                    </form>

                                    <form method="post" asp-page-handler="UpdateStatus" class="flex-grow-1">
                                        <input type="hidden" name="userId" value="@item.User.Id" />
                                        <input type="hidden" name="status" value="Approved" />
                                        <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                                        <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
                                        <button type="submit" class="btn btn-sm btn-success rounded-pill w-100 py-2 fw-semibold">
                                            <i class="bi bi-check-lg me-1"></i>@Localizer["ActionApprove"]
                                        </button>
                                    </form>
                                    <form method="post" asp-page-handler="UpdateStatus" class="flex-grow-1">
                                        <input type="hidden" name="userId" value="@item.User.Id" />
                                        <input type="hidden" name="status" value="Rejected" />
                                        <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                                        <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill w-100 py-2 fw-semibold">
                                            <i class="bi bi-x-lg me-1"></i>@Localizer["ActionReject"]
                                        </button>
                                    </form>
                                    <a asp-page="/Admin/EditUser" asp-route-id="@item.User.Id" class="btn btn-sm btn-outline-secondary rounded-pill flex-grow-1 py-2 text-center fw-semibold">
                                        <i class="bi bi-pencil me-1"></i>@Localizer["ActionEdit"]
                                    </a>
                                    <a asp-page="/Admin/DeleteUser" asp-route-id="@item.User.Id" class="btn btn-sm btn-danger rounded-pill flex-grow-1 py-2 text-center fw-semibold">
                                        <i class="bi bi-trash me-1"></i>@Localizer["ActionDelete"]
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small fst-italic w-100 text-center py-1">Protected Admin Account</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-4 px-3 text-muted">
                <i class="bi bi-inbox display-6 d-block mb-2"></i>
                <p class="mb-0 fs-6">@Localizer["NoRecordsFound"]</p>
            </div>
        }
    </div>
</div>