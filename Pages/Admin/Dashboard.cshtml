@page
@model MosqueRegistrationApp.Pages.Admin.DashboardModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{ 
    ViewData["Title"] = Localizer["PageTitle"]; 
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h2 class="fw-bold mb-1" style="color: var(--primary-emerald);">
            <i class="bi bi-shield-check text-gold me-2"></i>@Localizer["PortalTitle"]
        </h2>
        <p class="text-muted mb-0">@Localizer["PortalDescription"]</p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <form method="post" asp-page-handler="ExportCsv">
            <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
            <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
            <button type="submit" class="btn btn-gold shadow-sm">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i> @Localizer["ExportCsvButton"]
            </button>
        </form>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="card card-custom p-3 mb-4">
    <form method="get" class="row g-3">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" 
                       asp-for="SearchTerm" 
                       class="form-control border-start-0" 
                       placeholder="@Localizer["SearchPlaceholder"]" />
            </div>
        </div>
        <div class="col-md-3">
            <select asp-for="StatusFilter" class="form-select">
                <option value="All">@Localizer["FilterAllStatuses"]</option>
                <option value="Pending">@Localizer["FilterPending"]</option>
                <option value="Approved">@Localizer["FilterApproved"]</option>
                <option value="Rejected">@Localizer["FilterRejected"]</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-emerald flex-grow-1">@Localizer["FilterButton"]</button>
            <a asp-page="/Admin/Dashboard" class="btn btn-outline-secondary">@Localizer["ResetButton"]</a>
        </div>
    </form>
</div>

<!-- Member List Table Container -->
<div class="card card-custom overflow-hidden">
    <div class="card-header card-header-emerald d-flex justify-content-between align-items-center py-3">
        <h5 class="mb-0 fw-semibold"><i class="bi bi-people me-2"></i>@Localizer["TableHeaderTitle"]</h5>
        <span class="badge bg-white text-dark fw-bold">@Localizer["TotalLabel"]: @(Model.RegisteredUsers?.Count ?? 0)</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-custom align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-3">@Localizer["ColumnFullName"]</th>
                        <th>@Localizer["ColumnIcNumber"]</th>
                        <th>@Localizer["ColumnAddress"]</th>
                        <th>@Localizer["ColumnProofDocument"]</th>
                        <th>@Localizer["ColumnStatus"]</th>
                        <th class="text-end pe-3">@Localizer["ColumnActions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RegisteredUsers != null && Model.RegisteredUsers.Count > 0)
                    {
                        @foreach (var user in Model.RegisteredUsers)
                        {
                            <tr>
                                <td class="ps-3 fw-medium">@user.FullName</td>
                                <td><code>@user.IcNumber</code></td>
                                <td><small class="text-muted">@user.CurrentAddress</small></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(user.ProofOfResidencyImagePath))
                                    {
                                        <a href="@user.ProofOfResidencyImagePath" target="_blank" class="btn btn-sm btn-outline-success rounded-pill">
                                            <i class="bi bi-file-image me-1"></i> @Localizer["ViewProofButton"]
                                        </a>
                                    }
                                </td>
                                <td>
                                    @if (user.ApprovalStatus == "Approved")
                                    {
                                        <span class="badge-approved"><i class="bi bi-check-circle me-1"></i> @Localizer["StatusApproved"]</span>
                                    }
                                    else if (user.ApprovalStatus == "Rejected")
                                    {
                                        <span class="badge-rejected"><i class="bi bi-x-circle me-1"></i> @Localizer["StatusRejected"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge-pending"><i class="bi bi-hourglass-split me-1"></i> @Localizer["StatusPending"]</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <form method="post" asp-page-handler="UpdateStatus" style="display:inline;">
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <input type="hidden" name="status" value="Approved" />
                                        <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                                        <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
                                        <button type="submit" class="btn btn-sm btn-success rounded-pill px-3">@Localizer["ActionApprove"]</button>
                                    </form>
                                    <form method="post" asp-page-handler="UpdateStatus" style="display:inline;">
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <input type="hidden" name="status" value="Rejected" />
                                        <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                                        <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">@Localizer["ActionReject"]</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox display-6 d-block mb-2"></i>
                                @Localizer["NoRecordsFound"]
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>