@page
@model MosqueRegistrationApp.Pages.Admin.CreateUserModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{ 
    ViewData["Title"] = Localizer["PageTitle"]; 
}

<h2>@Localizer["Heading"]</h2>
<form method="post" enctype="multipart/form-data" class="mt-3" style="max-width: 600px;">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-2">
        <label>@Localizer["UsernameLabel"]</label>
        <input asp-for="Input.Username" class="form-control" required />
    </div>
    <div class="mb-2">
        <label>@Localizer["PasswordLabel"]</label>
        <input asp-for="Input.Password" type="password" class="form-control" required />
    </div>
    <div class="mb-2">
        <label>@Localizer["FullNameLabel"]</label>
        <input asp-for="Input.FullName" class="form-control" required />
    </div>
    <div class="mb-2">
        <label>@Localizer["IcNumberLabel"]</label>
        <input asp-for="Input.IcNumber" class="form-control" required />
    </div>
    <div class="mb-2">
        <label>@Localizer["CurrentAddressLabel"]</label>
        <textarea asp-for="Input.CurrentAddress" class="form-control" required></textarea>
    </div>
    <div class="mb-2">
        <label>@Localizer["MaritalStatusLabel"]</label>
        <input asp-for="Input.MaritalStatus" class="form-control" required />
    </div>
    <div class="mb-2">
        <label>@Localizer["ResidencyDurationLabel"]</label>
        <input asp-for="Input.ResidencyDurationYears" type="number" class="form-control" required />
    </div>
    <div class="mb-2">
        <label>@Localizer["ProofOfResidencyLabel"]</label>
        <input asp-for="Input.ProofOfResidency" type="file" class="form-control" />
    </div>
    <br />
    <button type="submit" class="btn btn-success">@Localizer["CreateMemberButton"]</button>
    <a asp-page="/Admin/Dashboard" class="btn btn-secondary">@Localizer["CancelButton"]</a>
</form>