@page "{id}"
@model MosqueRegistrationApp.Pages.Admin.DeleteUserModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{ 
    ViewData["Title"] = Localizer["PageTitle"]; 
}

<!-- Adaptive container spacing -->
<div class="row justify-content-center my-2 my-sm-4 px-1 px-sm-0">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card card-custom shadow-sm border-0 overflow-hidden">
            <!-- Danger Red Header -->
            <div class="card-header bg-danger text-white text-center py-3 px-3">
                <h4 class="mb-0 fw-bold fs-5 fs-sm-4">
                    <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>@Localizer["Heading"]
                </h4>
            </div>

            <div class="card-body p-3 p-sm-4">
                <!-- Warning Alert Box -->
                <div class="alert alert-warning d-flex align-items-center mb-3 p-2.5 p-sm-3 rounded-3" role="alert">
                    <i class="bi bi-shield-exclamation fs-4 text-warning me-2 flex-shrink-0"></i>
                    <div class="small lh-sm text-dark">
                        @Localizer["WarningMessage"]
                    </div>
                </div>

                <!-- Member Record Details Card -->
                <div class="card bg-light border p-3 mb-4 rounded-3">
                    <div class="mb-2">
                        <small class="text-muted text-uppercase fw-semibold fs-7 d-block">@Localizer["FullNameLabel"]</small>
                        <span class="fw-bold fs-6 text-dark">@Model.UserToDelete.FullName</span>
                    </div>
                    <div class="mb-2">
                        <small class="text-muted text-uppercase fw-semibold fs-7 d-block">@Localizer["IcNumberLabel"]</small>
                        <code class="fw-bold fs-6">@Model.UserToDelete.IcNumber</code>
                    </div>
                    <div>
                        <small class="text-muted text-uppercase fw-semibold fs-7 d-block">@Localizer["UsernameLabel"]</small>
                        <span class="fw-semibold fs-6 text-dark">@Model.UserToDelete.UserName</span>
                    </div>
                </div>

                <!-- Form Action Buttons (Stacked on mobile, side-by-side on tablet/desktop) -->
                <form method="post">
                    <div class="d-flex flex-column flex-sm-row gap-2 justify-content-end">
                        <a asp-page="/Admin/Dashboard" class="btn btn-outline-secondary btn-lg order-2 order-sm-1 w-100 w-sm-auto py-2.5 px-4 fs-6">
                            @Localizer["CancelButton"]
                        </a>
                        <button type="submit" class="btn btn-danger btn-lg order-1 order-sm-2 w-100 w-sm-auto py-2.5 px-4 fw-bold shadow-sm fs-6">
                            <i class="bi bi-trash3-fill me-1"></i> @Localizer["ConfirmDeleteButton"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>