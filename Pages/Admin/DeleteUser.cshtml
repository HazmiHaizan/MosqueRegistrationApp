@page "{id}"
@model MosqueRegistrationApp.Pages.Admin.DeleteUserModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{ 
    ViewData["Title"] = Localizer["PageTitle"]; 
}

<h2 class="text-danger">@Localizer["Heading"]</h2>
<div class="alert alert-warning mt-3">
    @Localizer["WarningMessage"]
</div>

<div class="card p-3 mb-3" style="max-width: 500px;">
    <p><strong>@Localizer["FullNameLabel"]:</strong> @Model.UserToDelete.FullName</p>
    <p><strong>@Localizer["IcNumberLabel"]:</strong> @Model.UserToDelete.IcNumber</p>
    <p><strong>@Localizer["UsernameLabel"]:</strong> @Model.UserToDelete.UserName</p>
</div>

<form method="post">
    <button type="submit" class="btn btn-danger">@Localizer["ConfirmDeleteButton"]</button>
    <a asp-page="/Admin/Dashboard" class="btn btn-secondary">@Localizer["CancelButton"]</a>
</form>