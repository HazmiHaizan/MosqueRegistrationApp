@page "{id}"
@model MosqueRegistrationApp.Pages.Admin.DeleteUserModel
@{ ViewData["Title"] = "Delete Member"; }

<h2 class="text-danger">Delete Member Account</h2>
<div class="alert alert-warning mt-3">
    Are you sure you want to delete this member account? This action cannot be undone.
</div>

<div class="card p-3 mb-3" style="max-width: 500px;">
    <p><strong>Full Name:</strong> @Model.UserToDelete.FullName</p>
    <p><strong>IC Number:</strong> @Model.UserToDelete.IcNumber</p>
    <p><strong>Username:</strong> @Model.UserToDelete.UserName</p>
</div>

<form method="post">
    <button type="submit" class="btn btn-danger">Yes, Delete Account</button>
    <a asp-page="/Admin/Dashboard" class="btn btn-secondary">Cancel</a>
</form>