@page "{id}"
@model MosqueRegistrationApp.Pages.Admin.EditUserModel
@{ ViewData["Title"] = "Edit Member"; }

<h2>Edit Member Information</h2>
<form method="post" enctype="multipart/form-data" class="mt-3" style="max-width: 600px;">
    <input type="hidden" asp-for="Input.Id" />
    <input type="hidden" asp-for="Input.ExistingImagePath" />
    
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-2"><label>Full Name</label><input asp-for="Input.FullName" class="form-control" required /></div>
    <div class="mb-2"><label>IC Number</label><input asp-for="Input.IcNumber" class="form-control" required /></div>
    <div class="mb-2"><label>Current Address</label><textarea asp-for="Input.CurrentAddress" class="form-control" required></textarea></div>
    <div class="mb-2"><label>Marital Status</label><input asp-for="Input.MaritalStatus" class="form-control" required /></div>
    <div class="mb-2"><label>Residency Duration (Years)</label><input asp-for="Input.ResidencyDurationYears" type="number" class="form-control" required /></div>
    
    <div class="mb-2">
        <label>Proof of Residency</label>
        @if (!string.IsNullOrEmpty(Model.Input.ExistingImagePath))
        {
            <div class="mb-1"><a href="@Model.Input.ExistingImagePath" target="_blank">View Existing Proof</a></div>
        }
        <input asp-for="Input.NewProofOfResidency" type="file" class="form-control" />
        <small class="text-muted">Leave empty to keep the existing document.</small>
    </div>
    <br />
    <button type="submit" class="btn btn-warning">Save Changes</button>
    <a asp-page="/Admin/Dashboard" class="btn btn-secondary">Cancel</a>
</form>