@page "{id}"
@model MosqueRegistrationApp.Pages.Admin.EditUserModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{ 
    ViewData["Title"] = Localizer["PageTitle"]; 
}

<h2>@Localizer["Heading"]</h2>
<form method="post" enctype="multipart/form-data" class="mt-3" style="max-width: 600px;">
    <input type="hidden" asp-for="Input.Id" />
    <input type="hidden" asp-for="Input.ExistingImagePath" />
    
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-2">
        <label>@Localizer["FullNameLabel"]</label>
        <input asp-for="Input.FullName" class="form-control" required />
    </div>
    <div class="mb-2">
        <label>@Localizer["IcNumberLabel"]</label>
        <input asp-for="Input.IcNumber" class="form-control" required />
    </div>
    <div class="mb-2">
        <label>@Localizer["CurrentAddressLabel"]</label>
        <textarea asp-for="Input.CurrentAddress" class="form-control" required></textarea>
    </div>
    <div class="mb-2">
        <label>@Localizer["MaritalStatusLabel"]</label>
        <input asp-for="Input.MaritalStatus" class="form-control" required />
    </div>
    <div class="mb-2">
        <label>@Localizer["ResidencyDurationLabel"]</label>
        <input asp-for="Input.ResidencyDurationYears" type="number" class="form-control" required />
    </div>
    
    <div class="mb-2">
        <label>@Localizer["ProofOfResidencyLabel"]</label>
        @if (!string.IsNullOrEmpty(Model.Input.ExistingImagePath))
        {
            <div class="mb-1">
                <a href="@Model.Input.ExistingImagePath" target="_blank">@Localizer["ViewExistingProofLink"]</a>
            </div>
        }
        <input asp-for="Input.NewProofOfResidency" type="file" class="form-control" />
        <small class="text-muted">@Localizer["KeepExistingDocHelpText"]</small>
    </div>
    <br />
    <button type="submit" class="btn btn-warning">@Localizer["SaveChangesButton"]</button>
    <a asp-page="/Admin/Dashboard" class="btn btn-secondary">@Localizer["CancelButton"]</a>
</form>