<!DOCTYPE html>
<html lang="@(Context.Features.Get<IRequestCultureFeature>()?.RequestCulture.Culture.Name ?? "ms")">
<head>
    @using Microsoft.AspNetCore.Builder
    @using Microsoft.AspNetCore.Localization
    @using Microsoft.AspNetCore.Mvc.Localization
    @using Microsoft.Extensions.Options
    @inject IOptions<RequestLocalizationOptions> LocOptions
    @inject IViewLocalizer Localizer

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>@ViewData["Title"] - @Localizer["BrandName"]</title>
    
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5.3 CSS & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <!-- Site Custom Stylesheet -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    <!-- Header / Navbar -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom shadow-sm py-2 py-lg-2.5">
            <div class="container px-3 px-sm-3">
                <!-- Brand Icon & Name -->
                <a class="navbar-brand d-flex align-items-center fw-bold me-2 fs-6 fs-sm-5" asp-page="/Index">
                    <span class="brand-icon me-2"><i class="bi bi-moon-stars-fill text-gold fs-5"></i></span>
                    <span class="brand-text tracking-wide">@Localizer["BrandName"]</span>
                </a>

                <!-- Mobile Header Right Actions (Language Switcher + Toggler) -->
                <div class="d-flex align-items-center gap-2">
                    @{
                        var requestCulture = Context.Features.Get<IRequestCultureFeature>();
                        var currentCulture = requestCulture?.RequestCulture.Culture.Name ?? "ms";
                        var returnUrl = string.IsNullOrEmpty(Context.Request.Path) ? "~/" : $"~{Context.Request.Path}{Context.Request.QueryString}";
                    }

                    <!-- Language Selector Dropdown -->
                    <form id="selectLanguage" asp-controller="Culture" asp-action="SetLanguage" asp-route-returnUrl="@returnUrl" method="post" class="d-inline">
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-light dropdown-toggle rounded-pill px-2.5 px-sm-3 py-1 fs-7 fw-semibold" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-globe me-1"></i> @(currentCulture == "ms" ? "MS" : "EN")
                                <span class="d-none d-sm-inline ms-1">@(currentCulture == "ms" ? Localizer["LanguageMalay"] : Localizer["LanguageEnglish"])</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2">
                                <li>
                                    <button type="submit" name="culture" value="ms" class="dropdown-item py-2 @(currentCulture == "ms" ? "fw-bold active" : "")">
                                        🇲🇾 @Localizer["LanguageMalay"]
                                    </button>
                                </li>
                                <li>
                                    <button type="submit" name="culture" value="en" class="dropdown-item py-2 @(currentCulture == "en" ? "fw-bold active" : "")">
                                        🇬🇧 @Localizer["LanguageEnglish"]
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </form>

                    <!-- Hamburger Mobile Toggler Button -->
                    <button class="navbar-toggler border-0 p-1.5 focus-ring focus-ring-light" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                </div>

                <!-- Collapsible Navigation Items -->
                <div class="collapse navbar-collapse mt-2 mt-lg-0" id="navbarContent">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-stretch align-items-lg-center gap-1 gap-lg-2 pt-2 pt-lg-0">
                        @if (User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link py-2 px-3 rounded-2 fw-medium" asp-page="/Admin/Dashboard">
                                        <i class="bi bi-speedometer2 me-2 me-lg-1"></i>@Localizer["AdminPortal"]
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link py-2 px-3 rounded-2 fw-medium" asp-page="/User/Dashboard">
                                        <i class="bi bi-person-badge me-2 me-lg-1"></i>@Localizer["MyProfile"]
                                    </a>
                                </li>
                            }
                            <li class="nav-item mt-1 mt-lg-0">
                                <form method="post" asp-controller="Account" asp-action="Logout" class="d-grid d-lg-inline">
                                    <button type="submit" class="btn btn-gold btn-sm rounded-pill px-3 py-2 py-lg-1.5 fw-bold shadow-sm" asp-page="/Account/Logout" method="post" asp-antiforgery="true">
                                        <i class="bi bi-box-arrow-right me-1"></i>@Localizer["Logout"]
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link py-2 px-3 rounded-2 fw-medium" asp-page="/Account/Login">
                                    <i class="bi bi-box-arrow-in-right me-2 me-lg-1"></i>@Localizer["Login"]
                                </a>
                            </li>
                            <li class="nav-item mt-1 mt-lg-0">
                                <a class="btn btn-gold btn-sm rounded-pill px-3 py-2 py-lg-1.5 fw-bold shadow-sm d-block d-lg-inline-block text-center" asp-page="/Account/Register">
                                    <i class="bi bi-person-plus me-1"></i>@Localizer["Register"]
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Body Container -->
    <main class="py-3 py-sm-4 flex-grow-1">
        <div class="container px-3 px-sm-3">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="footer-custom py-3 border-top mt-auto bg-white">
        <div class="container text-center text-muted fs-7 px-3">
            &copy; @DateTime.Now.Year @Localizer["FooterRights"]
        </div>
    </footer>

    <!-- Bootstrap 5.3 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>