@page
@model MosqueRegistrationApp.Pages.PrivacyModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"];
}

<!-- Adaptive container spacing -->
<div class="row justify-content-center my-2 my-sm-4 px-1 px-sm-0">
    <div class="col-12 col-md-10 col-lg-8">
        <div class="card card-custom shadow-sm border-0">
            <!-- Header with responsive typography matching other portal pages -->
            <div class="card-header card-header-emerald text-center py-3 px-3">
                <h4 class="mb-1 fw-bold fs-5 fs-sm-4"><i class="bi bi-shield-check text-gold me-2"></i>@Localizer["HeaderTitle"]</h4>
                <small class="text-white-50 d-block lh-sm fs-7">@Localizer["HeaderSubtitle"]</small>
            </div>

            <!-- Card body with structured PDPA sections -->
            <div class="card-body p-3 p-sm-4">
                
                <!-- Section 1: Introduction -->
                <h5 class="fw-bold mb-2 fs-6 fs-sm-5" style="color: var(--primary-emerald);">
                    <i class="bi bi-info-circle me-1"></i> @Localizer["Section1Title"]
                </h5>
                <p class="text-secondary fs-7 fs-sm-6 mb-3">
                    @Localizer["Section1BodyEn"]
                </p>
                <p class="text-secondary fs-7 fs-sm-6 mb-4">
                    <em>@Localizer["Section1BodyMs"]</em>
                </p>

                <hr class="my-3 text-secondary opacity-25" />

                <!-- Section 2: Data Collected -->
                <h5 class="fw-bold mb-2 fs-6 fs-sm-5" style="color: var(--primary-emerald);">
                    <i class="bi bi-database-lock me-1"></i> @Localizer["Section2Title"]
                </h5>
                <p class="text-secondary fs-7 fs-sm-6 mb-3">
                    @Localizer["Section2BodyEn"]
                </p>
                <p class="text-secondary fs-7 fs-sm-6 mb-4">
                    <em>@Localizer["Section2BodyMs"]</em>
                </p>

                <hr class="my-3 text-secondary opacity-25" />

                <!-- Section 3: Purpose of Processing -->
                <h5 class="fw-bold mb-2 fs-6 fs-sm-5" style="color: var(--primary-emerald);">
                    <i class="bi bi-check2-all me-1"></i> @Localizer["Section3Title"]
                </h5>
                <p class="text-secondary fs-7 fs-sm-6 mb-3">
                    @Localizer["Section3BodyEn"]
                </p>
                <p class="text-secondary fs-7 fs-sm-6 mb-4">
                    <em>@Localizer["Section3BodyMs"]</em>
                </p>

                <hr class="my-3 text-secondary opacity-25" />

                <!-- Section 4: Security & Access -->
                <h5 class="fw-bold mb-2 fs-6 fs-sm-5" style="color: var(--primary-emerald);">
                    <i class="bi bi-lock-fill me-1"></i> @Localizer["Section4Title"]
                </h5>
                <p class="text-secondary fs-7 fs-sm-6 mb-3">
                    @Localizer["Section4BodyEn"]
                </p>
                <p class="text-secondary fs-7 fs-sm-6 mb-4">
                    <em>@Localizer["Section4BodyMs"]</em>
                </p>

                <!-- Back button -->
                <div class="d-grid gap-2 mt-4">
                    <a asp-page="/Index" class="btn btn-outline-secondary btn-lg py-2.5 fw-bold fs-6">
                        <i class="bi bi-arrow-left me-1"></i> @Localizer["BackButton"]
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>