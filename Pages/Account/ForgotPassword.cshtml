@page
@model MosqueRegistrationApp.Pages.Account.ForgotPasswordModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{ 
    ViewData["Title"] = Localizer["PageTitle"]; 
}

<div class="row justify-content-center my-4 px-1 px-sm-0">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card card-custom shadow-sm border-0">
            <div class="card-header card-header-emerald text-center py-3 px-3">
                <h4 class="mb-1 fw-bold fs-5 fs-sm-4">
                    <i class="bi bi-shield-lock text-gold me-2"></i>@Localizer["CardHeaderTitle"]
                </h4>
                <small class="text-white-50 d-block lh-sm fs-7">@Localizer["CardHeaderSubtitle"]</small>
            </div>

            <div class="card-body p-4">
                <form method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3 small"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Username" class="form-label fw-semibold">@Localizer["UsernameLabel"]</label>
                        <input asp-for="Input.Username" class="form-control form-control-lg fs-6" placeholder="@Localizer["UsernamePlaceholder"]" required autocomplete="username" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.IcNumber" class="form-label fw-semibold">@Localizer["IcNumberLabel"]</label>
                        <input asp-for="Input.IcNumber" class="form-control form-control-lg fs-6" inputmode="numeric" placeholder="@Localizer["IcNumberPlaceholder"]" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.NewPassword" class="form-label fw-semibold">@Localizer["NewPasswordLabel"]</label>
                        <input asp-for="Input.NewPassword" type="password" class="form-control form-control-lg fs-6" placeholder="@Localizer["NewPasswordPlaceholder"]" required autocomplete="new-password" />
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold">@Localizer["ConfirmPasswordLabel"]</label>
                        <input asp-for="Input.ConfirmPassword" type="password" class="form-control form-control-lg fs-6" placeholder="@Localizer["ConfirmPasswordPlaceholder"]" required autocomplete="new-password" />
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-gold btn-lg py-2.5 fw-bold text-uppercase shadow-sm fs-6">
                            <i class="bi bi-arrow-repeat me-1"></i> @Localizer["ResetButton"]
                        </button>
                    </div>

                    <div class="text-center mt-3">
                        <a asp-page="/Account/Login" class="text-decoration-none small text-muted">
                            <i class="bi bi-arrow-left me-1"></i>@Localizer["BackToLogin"]
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>