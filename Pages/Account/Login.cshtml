@page
@model MosqueRegistrationApp.Pages.Account.LoginModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{ 
    ViewData["Title"] = Localizer["PageTitle"]; 
}

<div class="row justify-content-center my-5">
    <div class="col-md-6 col-lg-5">
        <div class="card card-custom shadow-sm">
            <div class="card-header card-header-emerald text-center py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-box-arrow-in-right text-gold me-2"></i>@Localizer["CardHeaderTitle"]</h4>
                <small class="text-white-50">@Localizer["CardHeaderSubtitle"]</small>
            </div>
            <div class="card-body p-4">
                <form method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3 small"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Username" class="form-label fw-semibold">@Localizer["UsernameLabel"]</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-person"></i></span>
                            <input asp-for="Input.Username" class="form-control" placeholder="@Localizer["UsernamePlaceholder"]" required />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.Password" class="form-label fw-semibold">@Localizer["PasswordLabel"]</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-lock"></i></span>
                            <input asp-for="Input.Password" type="password" class="form-control" placeholder="@Localizer["PasswordPlaceholder"]" required />
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-gold py-2 fw-bold text-uppercase shadow-sm">
                            <i class="bi bi-door-open-fill me-1"></i> @Localizer["LogInButton"]
                        </button>
                    </div>
                </form>
            </div>
            <div class="card-footer bg-light text-center py-3 border-top-0">
                <small class="text-muted">
                    @Localizer["NoAccountText"] 
                    <a asp-page="/Account/Register" class="fw-bold" style="color: var(--primary-emerald);">@Localizer["RegisterHereLink"]</a>
                </small>
            </div>
        </div>
    </div>
</div>