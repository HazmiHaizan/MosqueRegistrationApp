@page
@model MosqueRegistrationApp.Pages.Account.LoginModel
@{ ViewData["Title"] = "Login"; }

<h2>Account Login</h2>
<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div><label>Username</label><input asp-for="Input.Username" class="form-control" required /></div>
    <div><label>Password</label><input asp-for="Input.Password" type="password" class="form-control" required /></div>
    <br />
    <button type="submit" class="btn btn-success">Login</button>
</form>