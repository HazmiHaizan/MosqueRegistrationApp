@page
@model MosqueRegistrationApp.Pages.Account.RegisterModel
@{ ViewData["Title"] = "Mosque Registration"; }

<h2>Mosque Registration</h2>
<form method="post" enctype="multipart/form-data">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div><label>Username</label><input asp-for="Input.Username" class="form-control" required /></div>
    <div><label>Password</label><input asp-for="Input.Password" type="password" class="form-control" required /></div>
    <div><label>Full Name</label><input asp-for="Input.FullName" class="form-control" required /></div>
    <div><label>IC Number</label><input asp-for="Input.IcNumber" class="form-control" required /></div>
    <div><label>Current Address</label><textarea asp-for="Input.CurrentAddress" class="form-control" required></textarea></div>
    <div><label>Marital Status</label><input asp-for="Input.MaritalStatus" class="form-control" required /></div>
    <div><label>Residency Duration (Years)</label><input asp-for="Input.ResidencyDurationYears" type="number" class="form-control" required /></div>
    <div><label>Proof of Residency (Image Upload)</label><input asp-for="Input.ProofOfResidency" type="file" class="form-control" required /></div>
    <br />
    <button type="submit" class="btn btn-primary">Register Account</button>
</form>