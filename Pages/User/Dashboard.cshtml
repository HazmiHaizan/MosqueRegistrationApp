@page
@model MosqueRegistrationApp.Pages.User.DashboardModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{ 
    ViewData["Title"] = Localizer["PageTitle"]; 
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <!-- Header Title -->
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h2 class="fw-bold mb-1" style="color: var(--primary-emerald);">
                    <i class="bi bi-person-badge text-gold me-2"></i>@Localizer["DashboardHeader"]
                </h2>
                <p class="text-muted mb-0">@Localizer["DashboardSubtitle"]</p>
            </div>
        </div>

        <!-- Status Alert Banner -->
        @if (Model.CurrentUser.ApprovalStatus == "Pending")
        {
            <div class="card mb-4 border-warning bg-light">
                <div class="card-body d-flex align-items-center">
                    <div class="display-6 text-warning me-3"><i class="bi bi-hourglass-split"></i></div>
                    <div>
                        <h5 class="fw-bold text-warning mb-1">@Localizer["StatusPendingTitle"]</h5>
                        <p class="mb-0 text-muted small">@Localizer["StatusPendingDesc"]</p>
                    </div>
                </div>
            </div>
        }
        else if (Model.CurrentUser.ApprovalStatus == "Rejected")
        {
            <div class="card mb-4 border-danger bg-light">
                <div class="card-body d-flex align-items-center">
                    <div class="display-6 text-danger me-3"><i class="bi bi-x-circle"></i></div>
                    <div>
                        <h5 class="fw-bold text-danger mb-1">@Localizer["StatusRejectedTitle"]</h5>
                        <p class="mb-0 text-muted small">@Localizer["StatusRejectedDesc"]</p>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card mb-4 border-success bg-light">
                <div class="card-body d-flex align-items-center">
                    <div class="display-6 text-success me-3"><i class="bi bi-check-circle"></i></div>
                    <div>
                        <h5 class="fw-bold text-success mb-1">@Localizer["StatusApprovedTitle"]</h5>
                        <p class="mb-0 text-muted small">@Localizer["StatusApprovedDesc"]</p>
                    </div>
                </div>
            </div>
        }

        <!-- Profile Information Card -->
        <div class="card card-custom overflow-hidden mb-4">
            <div class="card-header card-header-emerald py-3">
                <h5 class="mb-0 fw-semibold"><i class="bi bi-person-lines-fill me-2"></i>@Localizer["PersonalDetailsHeader"]</h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="text-muted small text-uppercase fw-semibold">@Localizer["FullNameLabel"]</label>
                        <p class="fw-bold fs-5 mb-0">@Model.CurrentUser.FullName</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small text-uppercase fw-semibold">@Localizer["IcNumberLabel"]</label>
                        <p class="fw-bold fs-5 mb-0"><code>@Model.CurrentUser.IcNumber</code></p>
                    </div>
                    
                    <hr class="my-2 border-secondary opacity-25" />

                    <div class="col-md-6">
                        <label class="text-muted small text-uppercase fw-semibold">@Localizer["MaritalStatusLabel"]</label>
                        <p class="fw-semibold mb-0">@Model.CurrentUser.MaritalStatus</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small text-uppercase fw-semibold">@Localizer["ResidencyDurationLabel"]</label>
                        <p class="fw-semibold mb-0">@string.Format(Localizer["YearsFormat"].Value, Model.CurrentUser.ResidencyDurationYears)</p>
                    </div>

                    <hr class="my-2 border-secondary opacity-25" />

                    <div class="col-12">
                        <label class="text-muted small text-uppercase fw-semibold">@Localizer["ResidentialAddressLabel"]</label>
                        <p class="fw-semibold mb-0">@Model.CurrentUser.CurrentAddress</p>
                    </div>

                    <div class="col-12 mt-3">
                        <label class="text-muted small text-uppercase fw-semibold d-block mb-2">@Localizer["ProofOfResidencyLabel"]</label>
                        @if (!string.IsNullOrEmpty(Model.CurrentUser.ProofOfResidencyImagePath))
                        {
                            <div class="p-2 border rounded bg-light d-inline-block">
                                <img src="@Model.CurrentUser.ProofOfResidencyImagePath" alt="@Localizer["ProofImageAltText"]" class="img-fluid rounded" style="max-height: 250px; border: 1px solid var(--border-color);" />
                            </div>
                        }
                        else
                        {
                            <p class="text-muted small fst-italic">@Localizer["NoDocumentUploaded"]</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>