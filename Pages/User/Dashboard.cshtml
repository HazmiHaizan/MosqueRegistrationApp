@page
@model MosqueRegistrationApp.Pages.User.DashboardModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{ 
    ViewData["Title"] = Localizer["PageTitle"]; 
}

<div class="row justify-content-center my-2 my-sm-4 px-1 px-sm-0">
    <div class="col-12 col-lg-9">
        <!-- Header Title -->
        <div class="mb-3 mb-sm-4">
            <h2 class="fw-bold mb-1 fs-4 fs-md-2" style="color: var(--primary-emerald);">
                <i class="bi bi-person-badge text-gold me-2"></i>@Localizer["DashboardHeader"]
            </h2>
            <p class="text-muted mb-0 small fs-6">@Localizer["DashboardSubtitle"]</p>
        </div>

        <!-- Status Alert Banners -->
        @if (Model.CurrentUser.ApprovalStatus == "Pending")
        {
            <div class="card mb-3 mb-sm-4 border-warning bg-light shadow-sm">
                <div class="card-body p-3 p-sm-4 d-flex align-items-center">
                    <div class="fs-1 text-warning me-3 flex-shrink-0"><i class="bi bi-hourglass-split"></i></div>
                    <div>
                        <h5 class="fw-bold text-warning mb-1 fs-6 fs-sm-5">@Localizer["StatusPendingTitle"]</h5>
                        <p class="mb-0 text-muted small lh-sm">@Localizer["StatusPendingDesc"]</p>
                    </div>
                </div>
            </div>
        }
        else if (Model.CurrentUser.ApprovalStatus == "Rejected")
        {
            <div class="card mb-3 mb-sm-4 border-danger bg-light shadow-sm">
                <div class="card-body p-3 p-sm-4 d-flex align-items-center">
                    <div class="fs-1 text-danger me-3 flex-shrink-0"><i class="bi bi-x-circle"></i></div>
                    <div>
                        <h5 class="fw-bold text-danger mb-1 fs-6 fs-sm-5">@Localizer["StatusRejectedTitle"]</h5>
                        <p class="mb-0 text-muted small lh-sm">@Localizer["StatusRejectedDesc"]</p>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card mb-3 mb-sm-4 border-success bg-light shadow-sm">
                <div class="card-body p-3 p-sm-4 d-flex align-items-center">
                    <div class="fs-1 text-success me-3 flex-shrink-0"><i class="bi bi-check-circle"></i></div>
                    <div>
                        <h5 class="fw-bold text-success mb-1 fs-6 fs-sm-5">@Localizer["StatusApprovedTitle"]</h5>
                        <p class="mb-0 text-muted small lh-sm">@Localizer["StatusApprovedDesc"]</p>
                    </div>
                </div>
            </div>
        }

        <!-- Profile Information Card -->
        <div class="card card-custom overflow-hidden shadow-sm border-0 mb-4">
            <div class="card-header card-header-emerald py-3 px-3">
                <h5 class="mb-0 fw-semibold fs-6 fs-sm-5">
                    <i class="bi bi-person-lines-fill me-2"></i>@Localizer["PersonalDetailsHeader"]
                </h5>
            </div>
            <div class="card-body p-3 p-sm-4">
                <div class="row g-2 g-sm-3">
                    <div class="col-12 col-md-6">
                        <label class="text-muted fs-7 text-uppercase fw-semibold d-block mb-1">@Localizer["FullNameLabel"]</label>
                        <p class="fw-bold fs-6 fs-sm-5 mb-0 text-dark">@Model.CurrentUser.FullName</p>
                    </div>
                    <div class="col-12 col-md-6 mt-2 mt-md-0">
                        <label class="text-muted fs-7 text-uppercase fw-semibold d-block mb-1">@Localizer["IcNumberLabel"]</label>
                        <p class="fw-bold fs-6 fs-sm-5 mb-0"><code class="text-dark">@Model.CurrentUser.IcNumber</code></p>
                    </div>
                    
                    <div class="col-12"><hr class="my-2 text-secondary opacity-25" /></div>

                    <div class="col-12 col-md-6">
                        <label class="text-muted fs-7 text-uppercase fw-semibold d-block mb-1">@Localizer["MaritalStatusLabel"]</label>
                        <p class="fw-semibold fs-6 mb-0 text-dark">@Model.CurrentUser.MaritalStatus</p>
                    </div>
                    <div class="col-12 col-md-6 mt-2 mt-md-0">
                        <label class="text-muted fs-7 text-uppercase fw-semibold d-block mb-1">@Localizer["ResidencyDurationLabel"]</label>
                        <p class="fw-semibold fs-6 mb-0 text-dark">@string.Format(Localizer["YearsFormat"].Value, Model.CurrentUser.ResidencyDurationYears)</p>
                    </div>

                    <div class="col-12"><hr class="my-2 text-secondary opacity-25" /></div>

                    <div class="col-12">
                        <label class="text-muted fs-7 text-uppercase fw-semibold d-block mb-1">@Localizer["ResidentialAddressLabel"]</label>
                        <p class="fw-semibold fs-6 mb-0 text-dark">@Model.CurrentUser.CurrentAddress</p>
                    </div>

                    <div class="col-12 mt-3 pt-2 border-top">
                        <label class="text-muted fs-7 text-uppercase fw-semibold d-block mb-2">@Localizer["ProofOfResidencyLabel"]</label>
                        @if (!string.IsNullOrEmpty(Model.CurrentUser.ProofOfResidencyImagePath))
                        {
                            <div class="p-2 border rounded bg-light d-block d-sm-inline-block text-center text-sm-start">
                                <a href="@Model.CurrentUser.ProofOfResidencyImagePath" target="_blank" class="d-inline-block">
                                    <img src="@Model.CurrentUser.ProofOfResidencyImagePath" 
                                         alt="@Localizer["ProofImageAltText"]" 
                                         class="img-fluid rounded shadow-sm" 
                                         style="max-height: 220px; width: auto; object-fit: contain; border: 1px solid var(--border-color);" />
                                </a>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted small fst-italic mb-0">@Localizer["NoDocumentUploaded"]</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>